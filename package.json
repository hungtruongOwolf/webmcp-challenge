{
  "name": "messenger-clone",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:passkey-config && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:passkey-config": "node scripts/check-passkey-config.mjs"
  },
  "author": {
    "name": "hungtruongOwolf"
  },
  "description": "Verb -- nouns need eyes, verbs need a voice. A real-time messenger where every action is also a WebMCP tool, so a blind or low-vision user can fully operate it by talking to an AI agent.",
  "keywords": [
    "webmcp",
    "model-context-protocol",
    "accessibility",
    "screen reader",
    "voice agent",
    "nextjs",
    "react",
    "typescript",
    "supabase",
    "realtime",
    "chat app",
    "passkeys",
    "webauthn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hungtruongOwolf/webmcp-challenge.git"
  },
  "homepage": "https://github.com/hungtruongOwolf/webmcp-challenge#readme",
  "bugs": {
    "url": "https://github.com/hungtruongOwolf/webmcp-challenge/issues"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@tailwindcss/forms": "^0.5.11",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.23",
    "next": "15.5.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "react-spinners": "^0.17.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.10.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
