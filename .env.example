# Supabase project (Dashboard -> Project Settings -> API).
# The anon key is public; row-level security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Exact public origin and WebAuthn relying-party hostname -- these must match
# each other (protocol/host/port for the origin, bare hostname for the RP id).
# Local dev: http://localhost:3000 / localhost
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PASSKEY_RP_ID=localhost

# At least one of these enables describe_image and summarize_conversation.
# Tried in this order, falling through to the next on a transient failure.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
